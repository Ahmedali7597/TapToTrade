{
  "name": "tap-to-trade",
  "version": "1.0.0",
  "private": true,
  "description": "Local Magic: The Gathering inventory and trading website (COMP 10202 capstone).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/migrate.js",
    "seed": "node --env-file-if-exists=.env server/seed/seed.js",
    "make-admin": "node --env-file-if-exists=.env server/make-admin.js",
    "test": "jest --selectProjects server client",
    "test:coverage": "jest --selectProjects server --coverage",
    "test:api": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --selectProjects api --runInBand",
    "test:e2e": "npx --yes cypress@16 run",
    "test:postman": "npx --yes newman run postman/taptotrade.postman_collection.json --env-var baseUrl=http://localhost:3000"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1"
  }
}
