# Copy to .env and fill in. Never commit .env; never put secrets in VITE_* variables.

NODE_ENV=development
PORT=3000

# PostgreSQL 15+ connection strings. Neon: append ?sslmode=verify-full
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taptotrade
# Used ONLY by `npm run test:api`. The tests DROP and recreate this database's schema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taptotrade_test

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<PLACEHOLDER: paste a long random string>

# Public URL of the site, used in password-reset links and as the base of the Google redirect URI.
APP_BASE_URL=http://localhost:5173

# "Continue with Google" (optional; the button is hidden while these are empty). Create an OAuth client
# (type "Web application") in Google Cloud and add the redirect URI  <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps (optional). Without a key the maps use OpenStreetMap. Restrict the key to your site's address in
# Google Cloud; GOOGLE_MAPS_MAP_ID comes from Map Management (DEMO_MAP_ID is used when it's empty).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Resend (https://resend.com) HTTPS email API. Leave EMAIL_API_KEY empty in development:
# emails (welcome and confirm links, resets, trade updates) are then printed to the server console instead.
EMAIL_API_KEY=
EMAIL_FROM=Tap to Trade <support@taptotrade.ca>
# "resend" sends every email as a Resend template (wording editable in Resend's dashboard). Run
# `npm run emails:sync` once first to create the templates. Leave empty to send the app's built-in copy.
EMAIL_TEMPLATES=

# Password for the fictional seed accounts (npm run seed). Must meet the password policy.
SEED_PASSWORD=Seed-Only-Pass-1!
