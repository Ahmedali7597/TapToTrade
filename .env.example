# Copy to .env and fill in. Never commit .env; never put secrets in VITE_* variables.

NODE_ENV=development
PORT=3000

# PostgreSQL 15+ connection strings. Neon: append ?sslmode=verify-full
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taptotrade
# Used ONLY by `npm run test:api`. The tests DROP and recreate this database's schema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taptotrade_test

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<PLACEHOLDER: paste a long random string>

# Public URL of the site, used in password-reset links.
APP_BASE_URL=http://localhost:5173

# Resend (https://resend.com) HTTPS email API. Leave EMAIL_API_KEY empty in development:
# reset emails are then printed to the server console instead of sent.
EMAIL_API_KEY=
EMAIL_FROM=Tap to Trade <no-reply@your-verified-domain.example>

# Password for the fictional seed accounts (npm run seed). Must meet the password policy.
SEED_PASSWORD=Seed-Only-Pass-1!
